{
  "name": "lastfm-unscrobbler",
  "version": "0.0.1",
  "description": "A simple tool that will remove unwanted scrobbles from your Last.fm account",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "start": "node --experimental-strip-types --env-file=.env src/lastfm-unscrobble.ts",
    "start:dry-run": "npm start -- --dry-run",
    "start:debug": "npm start -- --debug",
    "set-password": "node --experimental-strip-types --env-file=.env src/set-password.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@napi-rs/keyring": "2.1.0",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
